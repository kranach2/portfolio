---
import { CLOUDFLARE_ANALYTICS_TOKEN } from "astro:env/server";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  current?: "work" | "info";
  // False for the not-found page, which has no address of its own.
  canonical?: boolean;
}
const { title, description, current, canonical = true } = Astro.props;
// Page addresses carry no trailing slash, matching the nav's links.
const path = Astro.url.pathname.replace(/(.)\/$/, "$1");
const canonicalUrl = new URL(path, Astro.site).href;
const previewImage = new URL("/og.png", Astro.site).href;
// Cookie-free analytics, in production builds with a token only.
const beaconToken = import.meta.env.PROD ? CLOUDFLARE_ANALYTICS_TOKEN : undefined;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={previewImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <script is:inline>
      // Before paint: the remembered theme, otherwise the system setting.
      let stored = null;
      try { stored = localStorage.getItem("theme"); } catch {}
      const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", dark);
    </script>
  </head>
  <body class="bg-[#f6f3ee] text-stone-900 dark:bg-[#161412] dark:text-stone-100">
    <a href="#main" class="sr-only rounded-full bg-stone-900 text-sm text-[#f6f3ee] focus:not-sr-only focus:absolute focus:left-6 focus:top-5 focus:z-20 focus:px-5 focus:py-2.5 dark:bg-stone-100 dark:text-stone-900">Skip to content</a>
    <div class="mx-auto max-w-5xl px-6 sm:px-10">
      <header>
        <Nav current={current} />
      </header>
      {/* Focusable so the skip link moves focus here, not only the scroll position. */}
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      const toggles = document.querySelectorAll("[data-theme-toggle]");
      const setPressed = (dark: boolean) =>
        toggles.forEach((b) => b.setAttribute("aria-pressed", String(dark)));
      setPressed(document.documentElement.classList.contains("dark"));
      toggles.forEach((b) =>
        b.addEventListener("click", () => {
          const dark = document.documentElement.classList.toggle("dark");
          setPressed(dark);
          try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
        }),
      );
      document.querySelectorAll<HTMLButtonElement>("[data-copy-email]").forEach((b) =>
        b.addEventListener("click", async () => {
          await navigator.clipboard.writeText(b.dataset.copyEmail!);
          const label = b.querySelector("[data-copy-label]") ?? b;
          const prev = label.textContent;
          label.textContent = "Copied";
          setTimeout(() => (label.textContent = prev), 1500);
        }),
      );
    </script>
    {beaconToken && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      ></script>
    )}
  </body>
</html>
