---
// Project page: one per published Project, in the Work page's look. Body
// sections come from the Project's Markdown headings, so a section the
// Project doesn't have is simply absent.
import { render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { getProfile, getPublishedProjects, type Project } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { title, kind, summary, stack, diagram, links } = project.data;
const profile = await getProfile();
const { Content } = await render(project);
const label = "text-sm uppercase tracking-[0.2em] text-stone-500 dark:text-stone-400";
const underline = "underline decoration-stone-400 underline-offset-4 hover:decoration-stone-900 dark:hover:decoration-stone-100";
// Tailwind's reset strips Markdown's default styling; restore it in the site's look.
const prose = [
  "max-w-2xl text-lg leading-relaxed text-stone-700 dark:text-stone-300",
  "[&_h2]:mt-16 [&_h2]:font-serif [&_h2]:text-4xl [&_h2]:text-stone-900 dark:[&_h2]:text-stone-100",
  "[&_h3]:mt-10 [&_h3]:font-serif [&_h3]:text-2xl [&_h3]:text-stone-900 dark:[&_h3]:text-stone-100",
  "[&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6",
  "[&_strong]:font-semibold [&_strong]:text-stone-900 dark:[&_strong]:text-stone-100",
].join(" ");
---
<Base title={`${title} · ${profile.name}`} description={summary}>
  <header class="pb-12 pt-20 sm:pt-32">
    <p class={`fade-in ${label}`}>{kind}</p>
    <h1 class="fade-in mt-6 max-w-4xl font-serif text-5xl leading-[1.05] sm:text-7xl" style="--i:1">{title}</h1>
    <ul aria-label="Stack" class="fade-in mt-10 flex max-w-3xl flex-wrap gap-2 text-sm" style="--i:2">
      {stack.map((item) => (
        <li class="rounded-full border border-stone-300 px-3 py-1 text-stone-600 dark:border-stone-700 dark:text-stone-300">{item}</li>
      ))}
    </ul>
    {links && (
      <p class="fade-in mt-8 flex gap-6 text-sm" style="--i:3">
        {links.code && <a href={links.code} class={underline}>Code ↗</a>}
        {links.demo && <a href={links.demo} class={underline}>Demo ↗</a>}
      </p>
    )}
  </header>

  <article class={`fade-in pb-16 ${prose}`} style="--i:3">
    <Content />
  </article>

  {diagram && (
    <section aria-labelledby="architecture-heading" class="pb-16">
      <h2 id="architecture-heading" class="font-serif text-4xl">Architecture</h2>
      <Image src={diagram.src} alt={diagram.alt} class="mt-8 w-full rounded-xl bg-white p-4 dark:bg-stone-800" />
    </section>
  )}

  <nav aria-label="More" class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-stone-300 py-10 text-sm dark:border-stone-700">
    <a href="/" class="mr-auto font-medium hover:text-stone-600 dark:hover:text-stone-300">← Back to all work</a>
    <a href={`mailto:${profile.email}`} class={underline}>Email me</a>
    <a href={profile.linkedin} class={underline}>LinkedIn</a>
    <a href={profile.github} class={underline}>GitHub</a>
  </nav>
</Base>
